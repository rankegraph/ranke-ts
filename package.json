{
  "name": "@rankegraph/ranke",
  "version": "0.0.0",
  "description": "TypeScript reader for the Ranke-Graph ADT: decode claims, build RankeQL queries.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "./scripts/test.sh"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rankegraph/ranke-ts.git"
  }
}
